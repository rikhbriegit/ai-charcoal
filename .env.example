# ── Ollama Cloud (AI engine — same model as ai-chat-embedded) ────────────────
# Key & endpoint dari Ollama Cloud (https://ollama.com). JANGAN commit key asli.
OLLAMA_API_KEY="YOUR_OLLAMA_API_KEY"
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_MODEL="glm-5.2:cloud"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port server (default 3001).
PORT=3001

# ── Keamanan (produksi) ──────────────────────────────────────────────────────
# Set 1 HANYA jika di belakang proxy tepercaya (Nginx) agar rate-limit pakai IP
# asli dari X-Forwarded-For. Jika app langsung exposed ke internet, JANGAN set.
TRUST_PROXY=0

# Origin browser yang boleh memanggil /api/chat (anti abuse kuota LLM lintas situs).
ALLOWED_ORIGINS="https://bricketcharcoal.com,https://www.bricketcharcoal.com,http://localhost:3001"

# Password gate panel admin SEO/Ads. Dibaca saat `npm run build`, di-embed ke
# bundle client. KOSONG = panel admin DINONAKTIFKAN total (aman secara default).
# Isi nilai kuat untuk mengaktifkan panel admin di produksi.
VITE_ADMIN_PASSWORD=""
